@baseUrl = http://localhost:3000
@password = Laser1234!

### Registro admin (idempotente)
POST {{baseUrl}}/users/register
Content-Type: application/json

{
  "email": "admin.madera@demo.com",
  "password": "{{password}}",
  "isAdmin": true
}

### Registro cliente (idempotente)
POST {{baseUrl}}/users/register
Content-Type: application/json

{
  "email": "cliente.madera@demo.com",
  "password": "{{password}}"
}

### Login admin
POST {{baseUrl}}/users/login
Content-Type: application/json

{
  "email": "admin.madera@demo.com",
  "password": "{{password}}"
}

### Login cliente
# Copia el token que devuelva este endpoint y pegalo abajo en @tokenCliente
POST {{baseUrl}}/users/login
Content-Type: application/json

{
  "email": "cliente.madera@demo.com",
  "password": "{{password}}"
}

@tokenCliente = REEMPLAZA_CON_TOKEN_CLIENTE
@tokenAdmin = REEMPLAZA_CON_TOKEN_ADMIN

### Ver fotos disponibles subidas
GET {{baseUrl}}/upload

### Crear categoria - Decoracion laser
POST {{baseUrl}}/categories
Content-Type: application/json

{
  "name": "Decoracion laser",
  "description": "Piezas decorativas en madera natural con grabado laser de alta precision.",
  "visible": true
}

### Crear categoria - Regalos personalizados
POST {{baseUrl}}/categories
Content-Type: application/json

{
  "name": "Regalos personalizados",
  "description": "Detalles unicos en madera grabada para celebraciones y eventos especiales.",
  "visible": true
}

### Crear producto simple usando imagen existente
POST {{baseUrl}}/products
Content-Type: application/json

{
  "title": "Placa Bienvenida Roble",
  "description": "Placa de bienvenida en madera de roble con grabado laser profundo y acabado al aceite natural.",
  "short_description": "Placa de roble grabada para entrada.",
  "price": 39.9,
  "sale_price": 34.9,
  "sku": "WOOD-PLACA-ROBLE-001",
  "stock_status": "in_stock",
  "stock_quantity": 24,
  "manage_stock": true,
  "type": "simple",
  "physical_attributes": {
    "length": 30,
    "width": 18,
    "height": 0.8,
    "weight": 0.45,
    "material": "roble"
  },
  "average_rating": 4.9,
  "categoria": ["Decoracion laser", "Senaletica en madera"],
  "custom_slug": "placa-bienvenida-roble-grabada",
  "image": "/uploads/1775032806491.jpg",
  "gallery": [
    "/uploads/1775032806491.jpg",
    "/uploads/1775033017159.jpg",
    "/uploads/1776006623846.JPG"
  ],
  "visible": true
}

